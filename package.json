{
  "name": "ci-workflows",
  "private": true,
  "version": "0.0.0",
  "description": "Reusable CI workflows and actions for Mobiweb Expo projects. Projects call them with uses: ...@v1.",
  "scripts": {
    "test": "jest",
    "typecheck": "tsc --noEmit",
    "lint:workflows": "docker run --rm -v \"$PWD:/repo\" -w /repo rhysd/actionlint:1.7.7 -color"
  },
  "devDependencies": {
    "@babel/core": "^7.28.0",
    "@babel/preset-env": "^7.28.0",
    "@babel/preset-typescript": "^7.27.1",
    "@types/jest": "29.5.14",
    "@types/node": "^24.0.0",
    "jest": "~29.7.0",
    "typescript": "~5.9.2",
    "yaml": "^2.9.1"
  },
  "packageManager": "pnpm@11.25.0",
  "engines": {
    "node": ">=24.19.0 <25"
  }
}
