#!/usr/bin/env bash
# Lets the QA agent type a value it must not see, such as a test account's password:
#   qa-fill-secret <@ref|selector> <MAESTRO_NAME>
# fills the input with that variable's value (the job exports them from the secret MAESTRO_ENV) through agent-device,
# so the value never passes through the agent's context. Only MAESTRO_* variables can be read.
set -euo pipefail

if [ $# -ne 2 ] || [[ ! "$2" =~ ^MAESTRO_[A-Z0-9_]+$ ]]; then
  echo "Usage: qa-fill-secret <@ref|selector> <MAESTRO_NAME>" >&2
  exit 2
fi
value="${!2:-}"
if [ -z "$value" ]; then
  echo "$2 is not set: the project's MAESTRO_ENV secret has no value for it." >&2
  exit 1
fi
exec agent-device fill "$1" "$value" --settle
